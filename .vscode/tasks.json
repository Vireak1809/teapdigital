{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Install wedding studio dependencies",
			"type": "shell",
			"command": "npm",
			"args": [
				"install"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Build wedding studio frontend",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": [
				"$tsc"
			]
		},
		{
			"label": "Start Ever After API",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"server:dev"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Start Ever After frontend",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"client:dev"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Audit production dependencies",
			"type": "shell",
			"command": "npm",
			"args": [
				"audit",
				"--omit=dev"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Test wedding studio APIs",
			"type": "shell",
			"command": "npm",
			"args": [
				"test"
			],
			"isBackground": false,
			"problemMatcher": []
		}
	]
}